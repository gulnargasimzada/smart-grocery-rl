# Copy this file to .env (same folder as app.py) and fill in what you need:
#     cp .env.example .env
# .env is in .gitignore, so your keys never get committed. Every line is optional.

# AI: plain-language explanations and reading ingredient photos.
# Paste the address of your deployed Netlify Function (see netlify/functions/explain.mjs).
# For local testing with `netlify dev`, use http://localhost:8888/.netlify/functions/explain
EXPLAIN_URL=

# USDA FoodData Central: extra US barcode coverage. Free key: https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=

# Barcode Lookup (paid): https://www.barcodelookup.com/api
BARCODELOOKUP_API_KEY=

# Note: the AI key (GEMINI_API_KEY, free, or ANTHROPIC_API_KEY) does NOT go here. Set it in Netlify (Project configuration > Environment variables),
# so the key stays on the server and never reaches the browser.
